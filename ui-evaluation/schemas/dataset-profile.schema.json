{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["fileName", "size", "delimiter", "rowCount", "columns"],
  "properties": {
    "fileName": { "type": "string" },
    "size": { "type": "integer" },
    "sizeBytes": { "type": "integer" },
    "delimiter": { "type": ["string", "null"], "enum": [",", ";", "\t", null] },
    "rowCount": { "type": "integer" },
    "columnCount": { "type": "integer" },
    "status": { "type": "string", "enum": ["success", "warning", "error"] },
    "duplicateRowCount": { "type": "integer" },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "nullCount"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["NUMBER", "DATE", "TEXT"] },
          "logicalType": { "type": "string", "enum": ["string", "integer", "decimal", "boolean", "date", "datetime", "mixed", "unknown"] },
          "nullCount": { "type": "integer" },
          "nullPercentage": { "type": "number" },
          "distinctCount": { "type": "integer" },
          "duplicateCount": { "type": "integer" },
          "invalidCount": { "type": "integer" },
          "sampleValues": { "type": "array" },
          "statistics": { "type": "object" },
          "potentialIdentifier": { "type": "boolean" },
          "potentialSensitiveData": { "type": "boolean" },
          "warnings": { "type": "array" }
        }
      }
    },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "profile": { "type": "object" }
  }
}
