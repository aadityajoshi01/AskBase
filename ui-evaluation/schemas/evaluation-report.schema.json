{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["timestamp", "mode", "metrics", "scenarios"],
  "properties": {
    "timestamp": { "type": "string" },
    "mode": { "type": "string", "enum": ["baseline_fixtures", "live"] },
    "metrics": { "type": "object" },
    "scenarios": { "type": "array", "items": { "type": "object" } }
  }
}
